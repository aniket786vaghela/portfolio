# Copy this file to .env.local for local development, and add the same two
# variables in Vercel → Project → Settings → Environment Variables.
# Find both in Supabase → Project Settings → API (or "API Keys").
# The anon / publishable key is safe in the browser: Row Level Security protects writes.
# Never put the service_role / secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
